# LLM
DEEPSEEK_API_KEY=sk-your-key-here

# 可选 兼容代理端点（主harness与Python子智能体共用）
# DEEPSEEK_BASE_URL=http://127.0.0.1:8000/v1

# 可选 Python子智能体服务端口
# XAGENTS_PORT=8077
# 可选 Python子智能体监听地址（默认仅本机）
# XAGENTS_HOST=127.0.0.1
# 可选 uvicorn worker 进程数（>1 时多进程；默认 1）
# XAGENTS_WORKERS=1
# 可选 日志级别 debug|info|warning|error（默认 info）
# XAGENTS_LOG_LEVEL=info
# 可选 单次模型调用超时秒数（默认 120）
# XAGENTS_LLM_TIMEOUT=120
# 可选 模型调用失败重试次数（默认 2）
# XAGENTS_LLM_MAX_RETRIES=2
# 可选 优雅停机等待秒数（默认 30）
# XAGENTS_GRACEFUL_TIMEOUT=30
# 可选 Python子智能体用的LLM
# XAGENTS_MODEL=deepseek-chat
# 可选 文档拆分任务的默认输出根目录（默认仓库根目录下的 outputs；
# 工具显式传入的相对 outputDir 会相对源文件所在目录解析）
# XAGENTS_OUTPUT_DIR=/absolute/path/to/outputs
# 可选 单个源文档大小上限（MB，默认 200，<=0 表示不限制）
# XAGENTS_MAX_SOURCE_MB=200
# 可选 语义分块时送给模型的最大字符数（默认 120000，超出后使用章节摘要）
# XAGENTS_SPLIT_MAX_CHARS=120000

# --- 图片型 PDF OCR ---
# 是否启用 OCR（默认 true；仅处理文本层过少的页面）
# XAGENTS_OCR_ENABLED=true
# auto | rapidocr | vision | none（auto 优先本地 RapidOCR，缺失时回退视觉接口）
# XAGENTS_OCR_PROVIDER=auto
# 云端视觉 OCR（provider=vision 或 auto 回退时使用，OpenAI 兼容 /chat/completions）
# XAGENTS_OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# XAGENTS_OCR_API_KEY=
# XAGENTS_OCR_MODEL=qwen-vl-max
# XAGENTS_OCR_LANGUAGE=chi_sim
# XAGENTS_OCR_DPI=180
# XAGENTS_OCR_TIMEOUT=60
# XAGENTS_OCR_MAX_RETRIES=1
# auto 模式下 RapidOCR 置信度低于该值时回退视觉模型（默认 0.5）
# XAGENTS_OCR_MIN_CONFIDENCE=0.5
# 页级并发（本地 RapidOCR 当前顺序执行；预留给视觉接口批量模式）
# XAGENTS_OCR_CONCURRENCY=1
# XAGENTS_OCR_MAX_PAGES=50

# --- HTTP服务（run.sh）---
# HTTP API鉴权token
# X_HARNESS_TOKEN=change-me
# web监听端口
# WEB_PORT=8080
# 注意 本版harness只允许绑定 127.0.0.1（0.0.0.0 会被安全策略拒绝）
# 要让外部调用 在前面放反向代理/隧道（nginx/caddy/ssh -L）
# WEB_HOST=127.0.0.1
