    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "lib/.client-cjs",
    "rootDir": "src",
    "types": ["node"],
    "baseUrl": ".",
